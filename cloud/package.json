{
  "name": "h0kd-video-requests-cloud",
  "private": true,
  "version": "0.1.0",
  "description": "Worker + Durable Object + D1 para el modulo Video Requests de h0kd-overlay",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "db:local": "wrangler d1 execute video-requests --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute video-requests --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.127.1"
  }
}
